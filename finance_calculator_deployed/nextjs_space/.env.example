# Copy this to .env (production/deployed) or .env.local (local override) and fill in real values.
# .env.local takes priority over .env in Next.js and is git-ignored — use it for local dev.

DATABASE_URL="postgresql://user:password@host:5432/dbname"
JWT_SECRET="replace-with-a-long-random-string"

# Only needed if using NextAuth-based flows (currently dormant — active auth is JWT/pg, see README)
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Deployment token for the Abacus.ai-hosted PDF generation service used by /api/generate-pdf
ABACUSAI_API_KEY=

# OPTIONAL. PDF engine: "abacus" (default when empty) or "local" (own headless Chromium, no offer
# data leaves the server). "local" needs PDF_CHROME_PATH, the path to a Chrome/Chromium binary, and
# on Linux also fonts that cover Polish/Czech/German, e.g. fonts-liberation.
PDF_RENDERER=
PDF_CHROME_PATH=

# OPTIONAL. Road-distance lookup for the transport calculator (/api/transport).
# Free key, no card: https://www.geoapify.com/ -> 3000 requests/day.
# Left empty, the app falls back to the public Nominatim + OSRM demo servers, which need
# no key but are rate-limited (~1 req/s) and have no SLA. Every result is cached in
# route_cache either way, and the salesperson can always type the kilometres by hand.
GEOAPIFY_API_KEY="your-abacus-api-key"

# OPTIONAL. AI assistant (docs/ai-assistant-plan.md). Off unless AI_ASSISTANT_ENABLED=true; needs
# migrations/037_ai_assistant.sql. Offer data is sent to the model provider, so keep
# AI_DATA_MODE=demo (demo database only) until the go-live gate in the plan is passed.
AI_ASSISTANT_ENABLED=
AI_DATA_MODE=demo
# Key from console.anthropic.com. Set a spend limit there as well.
ANTHROPIC_API_KEY=
# Default claude-sonnet-5-5.
AI_MODEL=
# Hard monthly stop in USD; the lower of this and Ustawienia (app_settings) wins.
AI_MONTHLY_BUDGET_USD=20
# Demo only: pins "today" (YYYY-MM-DD) so the golden-set questions resolve the same every day.
AI_FIXED_TODAY=
