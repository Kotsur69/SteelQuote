# Copy this to .env (production/deployed) or .env.local (local override) and fill in real values.
# .env.local takes priority over .env in Next.js and is git-ignored — use it for local dev.

DATABASE_URL="postgresql://user:password@host:5432/dbname"
JWT_SECRET="replace-with-a-long-random-string"

# Only needed if using NextAuth-based flows (currently dormant — active auth is JWT/pg, see README)
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Deployment token for the Abacus.ai-hosted PDF generation service used by /api/generate-pdf
ABACUSAI_API_KEY="your-abacus-api-key"
